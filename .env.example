# Backend (Django + EngineDj), con el prefijo /api. Next reenvía /backend/* aquí (sin CORS).
BACKEND_URL=https://hurgotrackback.devloop.com.co/api

# Opcional: llamar al backend directo desde el navegador (exige CORS en el backend).
# NEXT_PUBLIC_API_URL=https://hurgotrackback.devloop.com.co/api

# Redis (solo servidor Next: route handlers). Estado de steps y caché.
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=hurgotrack:
